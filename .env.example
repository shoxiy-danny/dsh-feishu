# Required
FEISHU_APP_ID=
FEISHU_APP_SECRET=
DEEPSEEK_API_KEY=

# Optional second / third / fourth bot on the same process
# FEISHU_APP_ID_2=
# FEISHU_APP_SECRET_2=
# FEISHU_APP_ID_3=
# FEISHU_APP_SECRET_3=
# FEISHU_APP_ID_4=
# FEISHU_APP_SECRET_4=

# Optional Lark international
# FEISHU_DOMAIN=

# Optional labels shown in /resume when another bot holds a session
# DSH_FEISHU_BOT_LABELS=cli_xxx=Work,cli_yyy=Home

# Optional extra models. See examples/models.json
# DSH_FEISHU_MODELS=/absolute/path/to/models.json

# Optional memory index folder that contains MEMORY.md
# Copy examples/memory/MEMORY.md there if you are starting empty.
# DSH_FEISHU_MEMORY_DIR=

# Optional prompt override (defaults to packaged prompts/)
# DSH_FEISHU_PROMPTS_DIR=

# Optional: walk CLAUDE.md / AGENTS.md on opened paths
# DSH_FEISHU_PROJECT_CLAUDE_MD=0
# DSH_FEISHU_CLAUDE_MD_EXCLUDES=

# Optional MCP pack trim. Default hides OmniCore / browser_* until enable_mcp.
# DSH_FEISHU_MCP_PACKS='omnicore:^mcp__OmniCore__;browser:^mcp__browser-mcp__'
# DSH_FEISHU_ALWAYS_TOOLS=mcp__browser-mcp__web_search,mcp__browser-mcp__fetch_page

# Optional high-risk bash guard. Set 0 to disable.
# DSH_FEISHU_GUARD=1

# Optional: restart wrapper script. Calls to it with no appId::chatId get the
# current window appended, so the post-restart receipt knows where to go.
# DSH_FEISHU_RESTART_SCRIPT=/absolute/path/to/restart.sh

# Runtime
# DSH_FEISHU_WORKSPACE=
# DSH_FEISHU_CWD=
# DSH_FEISHU_INBOX=
# DSH_FEISHU_CLI_SOCK=/tmp/dsh-feishu-cli.sock
# DSH_HOME=
